# Copy this file to .env, then paste your own key. Never commit .env.
# Any OpenAI-compatible provider works. DeepSeek is the default shown here.
HEKA_CLOUD_API_KEY=your_key_here
HEKA_CLOUD_BASE_URL=https://api.deepseek.com
# The cloud judge. Use deepseek-reasoner later for longer cross-day synthesis.
HEKA_MODEL=deepseek-chat
# Backward compatibility only: an older setup can still use DEEPSEEK_API_KEY.
# DEEPSEEK_API_KEY=your_key_here

# Local semantic organizer. It reads raw records, produces structured Trace,
# and never gets SQL or direct model-update authority.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# A failed schema check gets one local repair attempt; records are never stored if it still fails.
HEKA_LOCAL_REPAIR_RETRIES=1
# Optional. Change this if port 8787 is already in use.
HEKA_PORT=8787
HEKA_OBSIDIAN_DAILY_DIR=/absolute/path/to/your/Obsidian-vault/每日
